{
  "compilerOptions": {
    /* Type-check only: esbuild bundles ts/main.ts into a single classic script (target/js/main.js) run by GraalJS */
    "target": "es2024",                       /* GraalJS supports modern ECMAScript, no down-levelling needed. */
    "lib": ["es2024"],                        /* No DOM: the runtime is GraalJS embedded in the JVM. */
    "module": "preserve",                     /* Modules are resolved and bundled by esbuild. */
    "moduleResolution": "bundler",
    "types": ["node"],                        /* For `console` (provided by GraalJS). */
    "noEmit": true,
    "isolatedModules": true,                  /* Each file must be transpilable on its own, as esbuild does. */
    "skipLibCheck": true,

    /* Strict Type-Checking Options */
    "strict": false
  },
  "include": ["ts/**/*.ts"]
}
